# ============================================================
# InvoiceRapid — Variables de Entorno
# ============================================================
# Copia este archivo como .env.local y completa los valores.
# .env.local está en .gitignore, no se sube al repositorio.
# ============================================================

# ────── Supabase ──────
# URL y anon key del proyecto Supabase (públicas, en el cliente)
EXPO_PUBLIC_SUPABASE_URL=https://rvolqqtlmdyggrhfzwip.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ────── Google Sign-In ──────
# Web Client ID para autenticación con Google
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=60820876627-34g8eoho8tl91o1kihgpivheu0pvmka4.apps.googleusercontent.com

# ────── Google Mobile Ads ──────
# IDs de aplicación de AdMob (iOS debe ser DISTINTO de Android)
# Android: AdMob → Aplicaciones → copiar ID (formato: ca-app-pub-xxx~yyy)
GOOGLE_ADS_ANDROID_APP_ID=ca-app-pub-3758182602063783~1918923220

# iOS: Crear app en AdMob para iOS y obtener su ID propio
# ⚠️ NO usar el mismo ID que Android — los ingresos de iOS no se registrarán
GOOGLE_ADS_IOS_APP_ID=REEMPLAZAR_CON_IOS_APP_ID

# ────── EAS Build ──────
# ID del proyecto en Expo Application Services (EAS)
EAS_PROJECT_ID=45ccc530-324d-40e6-8434-15dae44a992c

# ────── Bundle Identifier ──────
# Identificador único de la app (obligatorio para builds)
BUNDLE_IDENTIFIER=com.zkrstudio.invoicerapidpro

# ────── RevenueCat ──────
# API key de RevenueCat para compras in-app
EXPO_PUBLIC_REVENUECAT_API_KEY=goog_LDnwkOlgqirTVPkaDRbvvGQWEHz
